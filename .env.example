# TRS Deal Sourcing Pipeline — environment configuration
#
# Copy this file to `.env` and fill in your keys:
#     cp .env.example .env
#
# `.env` is gitignored and must NEVER be committed. config.py loads it
# automatically (via python-dotenv) or you can export these in your shell.

# --- API keys ---
# SAM.gov entity API key — register at https://sam.gov
SAM_API_KEY=
# Census Bureau API key — register at https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
# DOL API key for OSHA enforcement data — https://devtools.dol.gov/developer
# (passed as X-API-KEY). Without it, the OSHA scraper skips.
DOL_API_KEY=
# PatentsView API key for USPTO enrichment — https://patentsview.org/apis
USPTO_API_KEY=

# --- Optional overrides ---
# Where to write the Excel pipeline workbook. Defaults to ./outputs/TRS_Deal_Pipeline.xlsx
# On your Windows machine you might use:
# TRS_EXCEL_OUTPUT_PATH=C:\Users\Owner\trs-deal-sourcing\outputs\TRS_Deal_Pipeline.xlsx
TRS_EXCEL_OUTPUT_PATH=

# Census County Business Patterns year (latest published is usually 2-3 years back)
CENSUS_CBP_YEAR=2022

# Politeness / run tuning
MAX_RESULTS_PER_SOURCE=500
REQUEST_DELAY_SECONDS=1.0
REQUEST_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO

# --- Weekly digest email (optional) ---
# If SMTP_HOST is blank, digest.py writes the HTML file but does not send mail.
WEEKLY_DIGEST_RECIPIENTS=brandon@trsinvestments.com,bob@trsinvestments.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=brandon@trsinvestments.com
