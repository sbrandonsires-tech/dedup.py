# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# SQLite database (regenerated on run)
*.db
*.db-journal
*.db-wal
data/trs.db

# Raw response cache and bulk downloads (re-fetchable; never committed)
cache/
data/*.zip
data/*.csv
data/*.txt

# Generated Excel workbooks
outputs/*.xlsx

# Logs
logs/*.txt
logs/*.log

# OS / editor
.DS_Store
.idea/
.vscode/

# Legacy code kept for reference, not part of the build
legacy/__pycache__/
